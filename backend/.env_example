# Copy to backend/.env and fill in. The file is read once, at import time:
# any missing line stops the application from starting at all.

# --- TMDB and OMDB ---------------------------------------------------------
# TMDB: a v4 read access token, sent as "Authorization: Bearer <token>".
TMDB_URL=https://api.themoviedb.org/3/
AUTHORIZATION=YOUR TMDB V4 READ ACCESS TOKEN
OMDB_URL=http://www.omdbapi.com/
OMDB_API_KEY=YOUR OMDB API KEY

# --- PostgreSQL ------------------------------------------------------------
# compose.yml publishes the container on 5555, not on the default 5432.
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5555
DATABASE_PASSWORD=CHOOSE A PASSWORD
DATABASE_NAME=watchlist
DATABASE_USERNAME=postgres

# --- Redis -----------------------------------------------------------------
# Optional: without this line the application falls back to the same default.
# REDIS_URL=redis://localhost:6379

# --- JWT -------------------------------------------------------------------
# SECRET_KEY signs every token: generate one, never reuse the example.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE YOUR OWN SECRET KEY
ALGORITHM=HS256
EXPIRE_TIME=300
